APP_NAME=ApplePoint
SECRET_KEY=GENERATE_A_NEW_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=720

# Local development:
DATABASE_URL=sqlite:///./applepoint.db
UPLOAD_DIR=uploads

# Production on Render with a persistent disk mounted at /var/data:
# DATABASE_URL=sqlite:////var/data/applepoint.db
# UPLOAD_DIR=/var/data/uploads

FRONTEND_ORIGINS=http://localhost:5173
LOW_STOCK_DEFAULT=3

AUTH_PROVIDER=firebase
FIREBASE_WEB_API_KEY=PASTE_YOUR_FIREBASE_WEB_API_KEY_HERE
FIREBASE_TIMEOUT_SECONDS=20
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
